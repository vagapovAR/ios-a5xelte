diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index 6dea9b97e..848d17eb7 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -402,6 +402,21 @@ static int
 ufs_take_over_host(void)
 {
 	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1)) {
+		/*
+		 * The S6 edge's S-Boot leaves the host controller disabled even
+		 * though the UIC/UTP layers report ready (probe: hcs 0x10f,
+		 * hce 0x0). Enable it and wait for the read-back.
+		 */
+		printf("HEROLTE UFS: host disabled (hcs 0x%x), enabling\n", hcs);
+		ufs_wr(REG_HCE, hce | 1);
+		for (int i = 0; i < 50 && !(ufs_rd(REG_HCE) & 1); i++) {
+			delay(1000);
+		}
+		hce = ufs_rd(REG_HCE);
+		hcs = ufs_rd(REG_HCS);
+		printf("HEROLTE UFS: enable done hce 0x%x hcs 0x%x\n", hce, hcs);
+	}
 	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
 		printf("HEROLTE UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
 		return ENXIO;

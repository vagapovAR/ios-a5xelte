 	delay(1000);
 }
 
+#define UIC_CMD_DME_SET 0x02
+
+/* DME_SET: arg1 = MIB attr/selector, arg2 = attr-set type (0), arg3 = val. */
+static int
+zerolte_ufs_dme_set(uint16_t attr, uint16_t sel, uint32_t val)
+{
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UIC_ARG1, ((uint32_t)attr << 16) | sel);
+	ufs_wr(REG_UIC_ARG2, 0);
+	ufs_wr(REG_UIC_ARG3, val);
+	ufs_wr(REG_UIC_CMD, UIC_CMD_DME_SET);
+	for (int i = 0; i < 100; i++) {
+		if (ufs_rd(REG_IS) & UIC_COMMAND_COMPL)
+			return (ufs_rd(REG_IS) & (1u << 2)) ? EIO : 0;
+		delay(1000);
+	}
+	return ETIMEDOUT;
+}
